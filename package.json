{
  "name": "penguinui",
  "private": false,
  "version": "1.8.0",
  "description": "一套适合开发者使用的轻量级 Vue 3 UI 组件库",
  "keywords": [
    "vue3",
    "ui",
    "components",
    "penguinui",
    "component-library",
    "vite"
  ],
  "homepage": "https://gitee.com/blue-sf/penguinui",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/blue-sf/penguinui.git"
  },
  "bugs": {
    "url": "https://gitee.com/blue-sf/penguinui/issues"
  },
  "author": "blue-sf",
  "main": "./dist/penguinui.umd.cjs",
  "module": "./dist/penguinui.js",
  "style": "./dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/penguinui.js",
      "require": "./dist/penguinui.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release": "npm version patch && npm publish"
  },
  "dependencies": {
    "@vue/runtime-dom": "^3.3.8",
    "axios": "^1.6.2",
    "highlight.js": "^11.9.0",
    "markdown-it": "^12.3.2",
    "pinia": "^2.1.7",
    "props": "^0.2.3",
    "sass": "^1.69.5",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.3",
    "@types/node": "^20.9.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/test-utils": "^2.4.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.53.0",
    "eslint-plugin-vue": "^9.18.1",
    "jest": "^29.7.0",
    "sass-loader": "^13.3.2",
    "vite": "^4.4.5",
    "vite-plugin-md": "^0.22.5",
    "vue-markdown-loader": "^2.5.0",
    "webpack-bundle-analyzer": "^4.10.1"
  }
}
